# ── Personal data — never commit ─────────────────────────────────────────────
# Library database (contains your reading history and ratings)
comics.db
comics.db-shm
comics.db-wal
config.json

# User-imported files and runtime-generated covers
user_comics/
static/covers/

# ── Xcode build products — regenerated by Xcode, never commit ────────────────
build/
app/
DerivedData/
*.dSYM
*.dSYM.zip
*.ipa

# Vendored local Swift packages: keep their source, drop their build output
# and any accidentally-nested .git directories from cloning instead of vendoring.
Packages/*/build/
Packages/*/.build/
Packages/*/.git/

# ── Xcode project state (machine/user-specific) ───────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
.swiftpm/
Package.resolved

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
