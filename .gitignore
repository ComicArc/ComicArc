# ── Personal data — never commit ─────────────────────────────────────────────
# Library database (contains your reading history and ratings)
comics.db
comics.db-shm
comics.db-wal
config.json

# User-imported files and runtime-generated covers
user_comics/
static/covers/

# GCD data dump + processed output — large binary artifacts, never committed.
# Tools/gcd_extract.py itself is the thing that's tracked.
Tools/*.sql
Tools/*.sqlite

# ── Xcode build products — regenerated by Xcode, never commit ────────────────
# app.noindex/ (not "app/") so the dev-convenience build copy is guaranteed excluded from
# Spotlight/Finder search -- the ".noindex" suffix is Apple's actual, always-effective
# exclusion convention; a hidden marker file inside a normally-named folder does not work
# reliably (confirmed empirically after it silently failed to prevent duplicate search results).
build/
app.noindex/
DerivedData/
*.dSYM
*.dSYM.zip
*.ipa

# Vendored local Swift packages: keep their source, drop their build output
# and any accidentally-nested .git directories from cloning instead of vendoring.
Packages/*/build/
Packages/*/.build/
Packages/*/.git/

# ── Xcode project state (machine/user-specific) ───────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
.swiftpm/
Package.resolved

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
